# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables, Secrets & Credentials
.env
.env.*
*.pem
*.key
*.cert
credentials.json
token.json

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Large Raw Datasets (protects confidential/audio data from upload)
data/raw/*.csv
data/raw/*.tsv
data/raw/*.parquet
data/raw/*.json
data/raw/*.zip
data/raw/*.tar.gz
!data/raw/.gitkeep

# Large Generated Output Exports (> 1 MB, reproducible from source)
outputs/task_level_warning_flags.csv
outputs/transcriber_risk_summary.csv
outputs/corrected_transcriber_analysis.csv
outputs/final_transcriber_block_analysis.csv

# Temporary exports, scratch files, and debug logs
*.log
scratch/
tmp/
temp/
